{
  "name": "canoe-scoreboard-v2",
  "private": true,
  "version": "3.5.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test tests/e2e/layout.spec.ts tests/e2e/dynamic.spec.ts tests/e2e/scroll.spec.ts tests/e2e/visual.spec.ts --ignore-snapshots",
    "c123-proxy": "node scripts/c123-proxy.js",
    "mock:tcp": "npx tsx scripts/mock-c123-tcp.ts",
    "mock:ws": "npx tsx scripts/mock-cli-ws.ts",
    "test:providers": "vitest run src/__tests__/provider-comparison.test.ts",
    "test:visual": "playwright test cli-vs-c123.spec.ts --project=vertical"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  }
}
